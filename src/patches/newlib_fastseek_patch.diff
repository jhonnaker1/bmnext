         FIL mFile;
+
+        /*
+         * FatFs's fast seek, for big files (disk images): without it a
+         * seek back follows the file's cluster chain from its start, one
+         * FAT sector read at a time, which for a file of gigabytes is
+         * hundreds of reads from the SD card a seek. The map of the
+         * file's clusters is made once, as it is opened. A file in fast
+         * seek mode can't grow, so the map is let go before it would.
+         */
+        static constexpr FSIZE_t FastSeekMinSize = 1024 * 1024;
+
+        void
+        StartFastSeek (void)
+        {
+#if FF_USE_FASTSEEK
+            if (f_size (&mFile) < FastSeekMinSize)
+            {
+                return;
+            }
+            DWORD items = 64;
+            for (int attempt = 0; attempt < 2; attempt++)
+            {
+                DWORD *table = static_cast<DWORD *> (malloc (items * sizeof (DWORD)));
+                if (table == nullptr)
+                {
+                    return;
+                }
+                table[0] = items;
+                mFile.cltbl = table;
+                FRESULT const fresult = f_lseek (&mFile, CREATE_LINKMAP);
+                if (fresult == FR_OK)
+                {
+                    return;
+                }
+                // Too small: the first item is the size needed.
+                items = table[0];
+                mFile.cltbl = nullptr;
+                free (table);
+                if (fresult != FR_NOT_ENOUGH_CORE)
+                {
+                    return;
+                }
+            }
+#endif
+        }
+
+        bool
+        FastSeeking (void) const
+        {
+#if FF_USE_FASTSEEK
+            return mFile.cltbl != nullptr;
+#else
+            return false;
+#endif
+        }
+
+        void
+        StopFastSeek (void)
+        {
+#if FF_USE_FASTSEEK
+            if (mFile.cltbl != nullptr)
+            {
+                free (mFile.cltbl);
+                mFile.cltbl = nullptr;
+            }
+#endif
+        }
         char *mFilename;
     };
 
