# zlib: everything but the examples and contrib.
ZLIB_SRCS = \
	adler32.c \
	compress.c \
	crc32.c \
	deflate.c \
	gzclose.c \
	gzlib.c \
	gzread.c \
	gzwrite.c \
	infback.c \
	inffast.c \
	inflate.c \
	inftrees.c \
	trees.c \
	uncompr.c \
	zutil.c

# zlib's configure script would find these (zconf.h).
ZLIB_CFLAGS = -DHAVE_UNISTD_H -DHAVE_STDARG_H -w

# The compiler options Previous's build gives its own sources: the CPU core
# is WinUAE's, and kept in step with it, so its warnings are left alone (-w
# here); -fwrapv as Previous's build has it (the CPU core counts on signed
# overflow wrapping). GCC 14 and later make passing an int * for an
# int32_t * an error, not a warning; with the 32-bit Arm toolchain int32_t
# is a long (the same size). Previous's host.h and the kernel's (src/host.h)
# both have a host_sleep_us(), with different arguments: Previous's is
# renamed (host_next.c has it).
PREVIOUS_CFLAGS = -std=gnu11 -fwrapv -w -Wno-incompatible-pointer-types \
                  -Dhost_sleep_us=host_sleep_us64

# Previous's include folders, in its build's order (src/CMakeLists.txt),
# after src/port (config.h and the SDL stand-in, compat/SDL3/SDL.h).
PREVIOUS_INCLUDE_DIRS = includes debug dsp softfloat dimension cpu
